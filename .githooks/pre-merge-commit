#!/bin/sh
# The guard on every merge commit: refuses model, archive or binary files the
# merge would bring in (scripts/check-no-models.sh), e.g. from a branch
# committed with --no-verify. Enabled per clone with
#   git config core.hooksPath .githooks
set -eu
# The guard next to this hook (the repository that holds it); git runs a
# hook from the top of the work tree being committed or pushed.
guard=$(cd "$(dirname "$0")/.." && pwd)/scripts/check-no-models.sh
exec "$guard" --staged
